{
  "name": "xvibe",
  "version": "0.1.0",
  "private": true,
  "description": "XVibe — vibe-coding studio on the Pluggie backend. Client of Pluggie over HTTP/MCP only.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "boundary": "node scripts/check-boundary.mjs",
    "spine": "node scripts/prove-spine.mjs",
    "verify-connection": "tsx scripts/verify-connection.mts",
    "evals": "tsx evals/run.mts",
    "vendor": "node scripts/build-vendor.mjs",
    "evals:reset": "tsx evals/reset.mts",
    "verify": "npm run typecheck && npm run boundary && npm run spine"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1098.0",
    "esbuild": "^0.28.1",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.23",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
